#!/bin/bash
#PBS -N wdrot1h
#PBS -q parexp
#PBS -l nodes=2:ppn=48
#PBS -l walltime=01:00:00
#PBS -o wdrot1h.out
#PBS -e wdrot1h.err
#
# 2 Msun rotating, toroidal-dominated white dwarf, 192^3, full MHD --
# WITH the field, in a short window sized to match the control.
#
# The field-free control reached t = 4.55 s on 2 nodes in 56 minutes, ringing
# from -11.6% to +16% and settling near +5% of its initial central density,
# with mass conserved to 0.013%. That is the same star, the same rotation,
# the same grid and the same gravity, so this run differs from it in exactly
# one thing: field_scale. Whatever separates the two curves is magnetic.
#
# Gravity is PoissonGrav, which solves over the real oblate density. Only the
# outer boundary condition is monopole, worth about 3% of the potential there
# and decaying inward -- against MonopoleGrav, which discarded the whole
# aspherical part everywhere.
#
# Queue: parexp, and the reason is availability, not doctrine. CENAPAD's
# documentation does designate paralela as the multi-node MPI queue (2-8
# nodes of 128 cores, up to 3 days), so a 2-node job was moved there -- and
# it sat queued at 12 h and again at 4 h. The pbsnodes output had the answer
# the whole time: every 128-core node (adano10-53) was job-exclusive, while
# 16 of the 48-core parexp nodes (adano59-80) stood free. paralela is the
# right queue by design and the wrong one by occupancy.
#
# Sizing, and what the failures taught. A 4-node/24 h parexp request sat
# queued 9.5 h, and a 2-node/12 h resubmission was refused identically, both
# with "Job would conflict with reservation or top job" while pbs_rstat showed
# NO reservation and 16 parexp nodes standing free. With nodes going spare,
# the thing that did not fit was the TIME: the scheduler holds free nodes for
# a higher-priority job and backfills only work finishing before it starts.
# Cut to 4 h and the job started within 20 seconds. CENAPAD's guide says the
# same thing in its own words -- request the minimum walltime the application
# needs rather than the queue maximum.
#
# 4 h, after 12 h was tried here and sat queued exactly as predicted. Three
# submissions now say the same thing: 24 h and 12 h wait, 4 h starts within
# seconds. The estimate at 256 ranks is 1.5-4 h, so one window may well
# finish it, and if it does not the restart below continues it. Getting the
# run STARTED is worth more than finishing it in a single window -- a job
# that waits produces nothing at all.
#
# Decomposition: inputs.rot192 sets max_grid_size 24, giving 8^3 = 512 boxes.
# Over the 192 ranks of four 48-core nodes that is 2 or 3 boxes each, so the
# step is set by the 3-box ranks and efficiency is 512/(192*3) = 89%. Not the
# exact division 256 ranks would give, but far above the 56% of the original
# 216-boxes-over-192-ranks layout, and comfortably clear of the 50% CPU
# efficiency below which the high-capacity queues may kill a job.
#
# Submit with the address on the command line rather than in the file -- this
# repository is public:
#   qsub -M your@email -m ae cluster/cenapad/job_rot192.pbs

cd "$PBS_O_WORKDIR"

module purge
module load openmpi/5.0.8-gcc-15.2.0

echo "host:  $(hostname)"
echo "start: $(date)"

NP="$(wc -l < "${PBS_NODEFILE:-/dev/null}" 2>/dev/null || true)"
[ -n "$NP" ] && [ "$NP" -gt 0 ] 2>/dev/null || NP="${PBS_NP:-96}"
echo "ranks: $NP  (PBS_NP='$PBS_NP', nodefile='${PBS_NODEFILE:-unset}')"

# Per-run directory: three concurrent jobs once wrote chk00000 and plt00000
# into the same place and overwrote each other.
RUNDIR="dir_rot1h"
mkdir -p "$RUNDIR"
cd "$RUNDIR"

# Refuse to start beside another instance. Two jobs did land in this
# directory at once and the second restarted from the first's half-written
# checkpoint.
if [ -f RUNNING ] && kill -0 "$(cat RUNNING 2>/dev/null)" 2>/dev/null; then
    echo "another instance is live in $RUNDIR (pid $(cat RUNNING)); refusing"
    exit 1
fi
echo "$$" > RUNNING
trap 'rm -f "$PBS_O_WORKDIR/$RUNDIR/RUNNING"' EXIT
ln -sf ../Castro3d.gnu.MPI.ex .
ln -sf ../rotating_mixed.txt .
ln -sf ../inputs.rot192 .

# Restart from the newest checkpoint if one is there, so a run truncated by
# the walltime is continued by resubmitting rather than repeated from zero.
RESTART=""
# chk00000 is excluded on purpose. It is the dump Castro writes during
# initialisation, so restarting from it gains nothing over starting fresh --
# and it is exactly the file that twice carried a half-written state from an
# aborted run into the next one, producing "State has NaNs in the density
# component" and costing two tests of an unrelated change.
LAST="$(ls -d chk????? 2>/dev/null | grep -v 'chk00000$' | sort | tail -1)"
if [ -n "$LAST" ] && [ -f "$LAST/Header" ]; then
    RESTART="amr.restart=$LAST"
    echo "restarting from $LAST"
else
    echo "starting from the initial model"
fi

mpirun -np "$NP" ./Castro3d.gnu.MPI.ex inputs.rot192 $RESTART \
    >> run_rot1h.log 2>&1
RC=$?
echo "log: $PBS_O_WORKDIR/$RUNDIR/run_rot1h.log ($(grep -ac '^STEP' run_rot1h.log) steps)"
grep -a "amrex::Abort" run_rot1h.log | head -1
echo "end:   $(date)"

# Chain the next window automatically. Backfill windows have been short --
# 4 h was refused with 17 nodes free -- so the run has to cross several of
# them, and babysitting that by hand costs more than the run.
#
# Three guards, because a job that resubmits itself is a job that can run
# away. It stops after CHAIN_MAX submissions; it stops unless this window
# actually produced a NEW checkpoint, so a run that aborts immediately does
# not respawn; and it stops once the log shows the target time reached.
CHAIN_MAX=8
N="$(cat ../chain_count_1h 2>/dev/null || true)"
STEPS="${STEPS:-0}"
LAST_NOW="$(ls -d chk????? 2>/dev/null | sort | tail -1)"
STEPS="$(grep -ac '^STEP' run_rot1h.log 2>/dev/null || true)"
STEPS="${STEPS:-0}"
REACHED="$(grep -a '^STEP' run_rot1h.log | tail -1 | sed 's/.*TIME = \([0-9.e+-]*\).*/\1/')"
DONE="$(awk -v t="${REACHED:-0}" 'BEGIN{print (t+0 >= 11.9) ? 1 : 0}')"

if [ "$N" -ge "$CHAIN_MAX" ]; then
    echo "chain: stopping, $N submissions already"
elif [ "$DONE" = "1" ]; then
    echo "chain: stopping, reached t = $REACHED s"
elif [ "$STEPS" -lt 1 ]; then
    # An abort during initialisation still leaves chk00000 behind, and the
    # first version of this guard counted that as progress: the window took
    # zero steps, resubmitted anyway, and the next job restarted from a
    # checkpoint the first was still writing. That produced
    # "State has NaNs in the density component" and wasted a test.
    echo "chain: stopping, the window took no steps at all"
elif [ -z "$LAST_NOW" ] || [ "$LAST_NOW" = "$LAST" ]; then
    echo "chain: stopping, this window produced no new checkpoint (was '$LAST', now '$LAST_NOW')"
else
    echo "$((N+1))" > ../chain_count_1h
    echo "chain: submission $((N+1)) of $CHAIN_MAX, continuing from $LAST_NOW (t = $REACHED s)"
    cd "$PBS_O_WORKDIR" && qsub "$0"
fi
# Propagate mpirun's status: without this a trailing echo becomes the script's
# exit code and PBS reports Exit_status=0 for a run that aborted.
exit "$RC"
