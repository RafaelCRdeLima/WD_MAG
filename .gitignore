amrex/
castro/
microphysics/

# The Braithwaite Castro problem (Exec/science/wd_braithwaite/) is tracked
# via a versioned MIRROR at castro_problems/wd_braithwaite/, synced with
# scripts/sync_wd_braithwaite.sh -- NOT via a .gitignore negation. Tested
# directly (scratch repo) and confirmed: git's own docs are right that "it
# is not possible to re-include a file if a parent directory of that file
# is excluded" -- no chain of "!" negations under an ignored castro/ can
# resurrect anything inside it. The mirror sidesteps the limitation
# entirely by living at a path castro/ never matches.
scf/.venv/
scf/__pycache__/
scf/tests/__pycache__/
scf/.pytest_cache/
**/__pycache__/
runs/
dashboard/runs/
*.pyc
dashboard/runs/
dashboard/exports/
dashboard/braithwaite_configs/
dashboard/k0_range_cache.json
dashboard/.streamlit/
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Castro crash dumps -- regenerated on every failed run, never useful in history
Backtrace.*
**/.pytest_cache/

# LaTeX build artifacts (papers/ is built with latexmk)
papers/**/*.aux
papers/**/*.log
papers/**/*.out
papers/**/*.fls
papers/**/*.fdb_latexmk
papers/**/*.blg
papers/**/*.synctex.gz

# Cross-check model file is generated by make_polytrope.py
flash_crosscheck/*.dat
flash_crosscheck/objdir*/
flash_crosscheck/FLASH4.8/

# Braithwaite paper preserved from the earlier mixed-field draft
papers/wd-braithwaite-relaxation/*.aux
papers/wd-braithwaite-relaxation/*.log
papers/wd-braithwaite-relaxation/*.fls
papers/wd-braithwaite-relaxation/*.fdb_latexmk
papers/wd-braithwaite-relaxation/*.blg

# The chained PBS jobs read the notification address from here; this
# repository is public, so the address stays out of it.
mailto

# Regenerated by investigations/plot_bt_bp.py; the pdf is the artefact.
investigations/bt_bp_192.png
investigations/field_slices_192.png
investigations/slices_192.tar.gz
investigations/mass_radius_192.png
