# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Pre-relaxation test (user-directed, this session): field-free
# (E_mag_over_W_target=0), hydro-only build (USE_MHD=FALSE), with
# well-balanced reconstruction (castro.use_pslope=1) AND
# castro.grav_source_type=4 -- the full Exec/gravity_tests/evrard_collapse
# combination. The prior inputs.pslope_hydrotest in this directory
# referenced grav_source_type=4 in a comment but never actually set it
# (grep-confirmed absent from that file) -- fixed here, since running
# without it was not actually the validated combination it claimed to
# be. model.dat regenerated fresh via braithwaite_app/core/scf_store.py
# (rho_c=1e9 g/cm^3, mu_e=2.0, git_commit_scf=983f5df, VE=1.10e-4,
# neutronization OK) rather than reusing whatever was already on disk.
#
# Goal: run long enough to see past damping ramping off
# (damping_end_time_in_tdyn=20, ramp starts at 18) -- the prior
# pslope_hydrotest run only reached stop_time=4.5s (~16.3 t/t_dyn for
# this star), never actually leaving the full-damping regime. stop_time
# here is set generously past that.
max_step = 3000
stop_time = 15.0

geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0
geometry.prob_lo     = -4.9765625e8 -4.9765625e8 -4.9765625e8
geometry.prob_hi     =  4.8234375e8  4.8234375e8  4.8234375e8
amr.n_cell           =  64   64   64

castro.lo_bc       =  2   2   2
castro.hi_bc       =  2   2   2

castro.do_hydro = 1
castro.do_react = 0
castro.ppm_type = 0
castro.use_flattening = 0

castro.do_grav = 1
gravity.gravity_type = MonopoleGrav
gravity.drdxfac = 2

castro.cfl            = 0.5
castro.init_shrink    = 0.01
castro.change_max     = 1.1

castro.sum_interval   = 1
castro.v              = 1
amr.v                 = 1

amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 64

# plot_int raised relative to inputs.pslope_hydrotest (10->50): rho_c(t)
# tracking reads the LOG (sum_interval=1, every step), not plotfiles --
# plotfiles here are only for freezing a checkpoint at the end, so a
# long run doesn't need one every 10 steps.
amr.check_file      = chk_prerelax
amr.check_int       = 100
amr.plot_file       = plt_prerelax
amr.plot_int        = 50
amr.derive_plot_vars = density x_velocity y_velocity z_velocity eden Temp pressure

castro.small_dens = 1.0e4
castro.small_temp = 1.0e3

castro.do_sponge = 1
castro.sponge_upper_density = 1.0e5
castro.sponge_lower_density = 1.0e4
castro.sponge_timescale     = 1.0e-4

castro.add_ext_src = 1

problem.model_name = "model.dat"
problem.rng_seed = 42
problem.E_mag_over_W_target = 0.0
problem.n_modes = 10
problem.dominant_scale_over_R = 0.3
problem.mode_scale_band_factor = 3.0
problem.field_cutoff_frac = 0.8
problem.envelope_transition_frac = 0.2
problem.surface_density_frac = 2.0e-4
problem.nsub = 8
problem.damping_timescale_in_tdyn = 0.2
problem.damping_end_time_in_tdyn = 20.0
problem.damping_ramp_in_tdyn = 2.0

castro.use_pslope = 1
castro.grav_source_type = 4
