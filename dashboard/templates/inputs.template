# Generated by the wd-magnetizada dashboard (Tab 3 — export). Do NOT edit
# by hand; regenerate from the dashboard if something needs to change.
# See plano_wd_magnetizada.md section 5. Parameter names must be checked
# against the real Castro problem setup (Exec/science/magnetized_wd) once
# Phase 0 compiles — this template is the starting point, not the final word.

max_step  = 1000000
stop_time = {stop_time:.6e}

geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = -{box_half:.6e} -{box_half:.6e} -{box_half:.6e}
geometry.prob_hi     =  {box_half:.6e}  {box_half:.6e}  {box_half:.6e}

amr.n_cell    = {n_cell} {n_cell} {n_cell}
amr.max_level = 0

castro.small_dens = {small_dens:.6e}

gravity.gravity_type = PoissonGrav

castro.do_sponge           = 1
castro.sponge_lower_radius = {sponge_radius:.6e}
castro.sponge_timescale    = {sponge_timescale:.6e}

# velocity perturbation to break axisymmetric symmetry (D3) — seed is
# mandatory and logged (see run_manifest.json)
problem.seed               = {seed}
problem.perturb_amplitude  = {perturb_amplitude:.6e}

# initial data (Component A -> Component B, see Tab 3)
problem.initial_data_file  = {initial_data_file}
