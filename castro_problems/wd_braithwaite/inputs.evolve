# ------------------  INPUTS TO MAIN PROGRAM  -------------------
# Step 3: dynamical relaxation of the Step-2 seed field. Unlike
# `inputs` (Step 2's static, max_step=0 IC check), this evolves the
# star -- gravity must be on (USE_GRAV=TRUE, see GNUmakefile) or the
# star just flies apart from unbalanced pressure with no restoring
# force, unrelated to the actual Braithwaite physics being tested.
#
# Attempt 2: global velocity damping during the initial accommodation
# phase (see problem_source.H, docs/teoria.md Sec 6.4). Attempt 1
# (no damping) showed dt does NOT collapse from the fluff -- the
# original central risk -- but rho_c climbed +40% and was still
# accelerating at t=0.021s (69 steps), unlike the temperature transient
# which visibly peaked and decayed. Diagnosis: the Step 2 IC was never
# in magnetohydrostatic equilibrium (built against gas pressure +
# gravity only), so releasing the seed field cold left nothing to
# absorb the transient. Damping is active for the first
# damping_end_time_in_tdyn * t_dyn (default 5 t_dyn, ramped off over
# the preceding 1 t_dyn) -- t_dyn itself is computed from the real
# star (problem_initialize.H), printed at startup.
#
# max_step here is a generous safety cap for a development run at
# n_cell=64 (kept modest deliberately -- the qualitative Braithwaite
# signal doesn't need Step 5's resolution study yet), not a target to
# reach: watch for rho_c stabilizing (the success criterion) and stop
# manually once it does or clearly doesn't.
max_step = 5000
stop_time = 7.366

geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0
geometry.prob_lo     = -4.90e8 -4.90e8 -4.90e8
geometry.prob_hi     =  4.90e8  4.90e8  4.90e8
amr.n_cell           =  64   64   64

castro.lo_bc       =  2   2   2
castro.hi_bc       =  2   2   2

# WHICH PHYSICS
castro.do_hydro = 1
castro.do_react = 0
castro.ppm_type = 0
castro.use_flattening = 0

castro.do_grav = 1
gravity.gravity_type = MonopoleGrav
gravity.drdxfac = 2

# TIME STEP CONTROL
castro.cfl            = 0.5
castro.init_shrink    = 0.01
castro.change_max     = 1.1

# DIAGNOSTICS & VERBOSITY
castro.sum_interval   = 1
castro.v              = 1
amr.v                 = 1

# REFINEMENT / REGRIDDING -- no imposed symmetry (full 3D Cartesian,
# no reflection/quadrant BCs) per the plan's explicit requirement
amr.max_level       = 0
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2
amr.blocking_factor = 8
amr.max_grid_size   = 32

# CHECKPOINT / PLOTFILES
amr.check_file      = chk
amr.check_int       = 50
amr.plot_file       = plt
amr.plot_int        = 10
amr.derive_plot_vars = density x_velocity y_velocity z_velocity eden Temp pressure B_x B_y B_z

# FLUFF HANDLING -- the central risk of this step (see plan). Analytic
# pre-check (not guessed): with the Step-2 density floor
# (rho_c*1e-10=1e-1 g/cm^3) and the ~3% exterior B leakage measured in
# Step 2, v_A right at/beyond R_star comes out to ~3e11 cm/s -- TEN
# TIMES the speed of light, i.e. exactly the fluff catastrophe the
# plan warned about, confirmed before ever running rather than
# discovered by a crash. Raising castro.small_dens to 1e4 g/cm^3 (and
# regenerating model.dat with a matching density_floor_fraction=1e-4,
# so init doesn't abort on rho < small_dens) brings the boundary v_A
# down to ~3e9 cm/s -- comparable to the interior CFL, not dominant.
castro.small_dens = 1.0e4
castro.small_temp = 1.0e3

# density-threshold sponge (Exec/gravity_tests/StarGrav's convention)
# to actively damp velocity in the low-density exterior on top of the
# raised floor -- mechanically MHD-compatible (Castro_sponge.cpp is a
# pure momentum source term, never touches B) but NOT a substitute for
# the density floor above: the sponge damps velocity, while the CFL
# constraint in MHD comes from the fast magnetosonic wave speed
# (Castro's own timestep::estdt<mhd>, built from B and rho directly,
# confirmed by reading Source/driver/Castro.cpp) -- a velocity-only
# damper cannot cap a wave speed. Both are needed; neither alone is.
castro.do_sponge = 1
castro.sponge_upper_density = 1.0e5
castro.sponge_lower_density = 1.0e4
castro.sponge_timescale     = 1.0e-4

# GLOBAL damping during accommodation (problem_source.H) -- unlike the
# sponge above (exterior only, density-threshold gated), this applies
# to every cell, gated purely on time. Requires add_ext_src=1 or
# problem_source() is never called (Source/problems/Castro_problem_source.cpp).
castro.add_ext_src = 1

# PROBLEM PARAMETERS
problem.model_name = "model.dat"
problem.rng_seed = 42
problem.E_mag_over_W_target = 0.15
problem.n_modes = 10
problem.dominant_scale_over_R = 0.3
problem.mode_scale_band_factor = 3.0
problem.envelope_transition_frac = 0.2
# MUST be set above the model file's own density_floor_fraction (1e-4
# for this run's model.dat, regenerated with a raised floor to support
# castro.small_dens=1e4 -- see the FLUFF HANDLING note above) or the
# surface-detection loop in problem_initialize.H never finds a point
# below threshold and silently falls back to the last model row (the
# domain edge, not the true stellar surface) -- exactly the bug the
# first two evolve attempts had (R_star off by +7.6%, ~2.63e8 instead
# of ~2.39e8 cm, feeding a too-large confinement radius and a
# slightly-too-large |W| from double-counting a floored "fluff" shell
# as stellar mass). 2e-4 sits just above the floor, catching the real
# declining profile before it flattens.
problem.surface_density_frac = 2.0e-4
problem.damping_timescale_in_tdyn = 0.2
problem.damping_end_time_in_tdyn = 5.0
problem.damping_ramp_in_tdyn = 1.0

# EOS -- ztwd (matches the SCF's own EOS), see GNUmakefile for why.
# No runtime eos.* params -- ztwd has none (see EOS/ztwd/_parameters).
