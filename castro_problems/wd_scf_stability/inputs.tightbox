# DOMAIN TEST: same star, same dx, smaller box.
#
# Four configurations spanning E_tor/|W| from 0.073 to 0.203 -- a factor 2.8
# in magnetic support -- all died between 2.24 and 2.52 s. A death time that
# ignores the one physical parameter being varied is the signature of a
# common clock, not of a magnetic instability.
#
# The candidate clock is the ambient. castro.small_dens = 1e4 floors a domain
# of (1.8e9)^3, which is 0.06 Msun of floor material, and the field-free
# control that SURVIVED ran in a box five times smaller in volume -- a
# confound I introduced when I scaled its domain to match cells-across.
#
# This run changes ONE thing: 72 cells at the same 1.875e7 cm spacing, so the
# star is resolved identically and the ambient volume drops to 44% of what
# the 96^3 run had. The star (R_pol = 5.736e8) still fits with 16% margin.
# If the death time moves, the ambient is the clock and Phase 1 measured the
# setup. If it stays at 2.5 s, the star is. Evolves the magnetized SCF equilibrium for ten
# Alfven crossing times, looking for the m = 1 Tayler mode.
#
# Total = 1.68 s of damped relaxation + 10 t_A of undamped
# measurement = 14.3 s.
#
# t_A = R/<v_A> = 1.68 s for this configuration (mass-weighted Alfven speed
# 3.4e8 cm/s over R = 5.74e8 cm), so stop_time = 6.0 s is 10 t_A. The CFL
# step at 64^3 is ~1.4e-2 s, hence a few thousand steps -- the Braithwaite
# study's 0.23 t_A ceiling does not bind here, because this field is three
# orders of magnitude stronger and its Alfven time correspondingly shorter.
#
# Domain: HALF-SHIFT geometry (docs/teoria.md Sec 6.6). prob_lo = -(N+1)/2*dx
# and prob_hi = (N-1)/2*dx, so a cell CENTRE lands exactly on r = 0.
max_step = 0, so nothing evolves.
#
# Domain: HALF-SHIFT geometry (docs/teoria.md Sec 6.6). prob_lo = -(N+1)/2*dx
# and prob_hi = (N-1)/2*dx, so a cell CENTRE lands exactly on r = 0. The
# symmetric domain misaligns the star's centre with the mesh and shows up as a
# several-percent error in the central density; this removes it. With N = 64
# and dx = 2.8125e7 cm the half-width is 9.0e8 cm, comfortably outside the
# star's R_pol = 5.736e8 cm.
max_step = 20000
stop_time = 6.0

geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0
geometry.prob_lo     = -6.8437500000e+08 -6.8437500000e+08 -6.8437500000e+08
geometry.prob_hi     = 6.6562500000e+08 6.6562500000e+08 6.6562500000e+08
amr.n_cell           =  72  72  72

castro.lo_bc       =  2   2   2
castro.hi_bc       =  2   2   2

castro.do_hydro = 1
castro.do_react = 0
castro.ppm_type = 0
castro.use_flattening = 0

castro.do_grav = 1
gravity.gravity_type = MonopoleGrav
gravity.drdxfac = 2

castro.cfl            = 0.5
castro.init_shrink    = 0.01
castro.change_max     = 1.1
castro.sum_interval   = 1
castro.v              = 1
amr.v                 = 1

amr.max_level       = 0
# blocking_factor 4, not the 8 inherited from the 96^3 inputs: AMReX requires
# max_grid_size to be divisible by it, and 12 is not a multiple of 8. 12 was
# chosen to give 6^3 = 216 boxes on a 72^3 mesh, about 4.5 per rank.
# blocking_factor only sets the minimum block size, so the comparison with
# the 96^3 run is unaffected.
amr.blocking_factor = 4
amr.max_grid_size   = 12
amr.plot_file       = plt
amr.check_file      = chk
amr.check_int       = 200
amr.plot_int        = 20
amr.derive_plot_vars = density x_velocity y_velocity z_velocity eden Temp pressure B_x B_y B_z Div_B emag_density etor_density

# Sec 6.5: small_dens is 1.0e4 g/cm^3, not 1e-4 -- the ambient has to be
# heavy enough that the boundary Alfven speed stays finite.
castro.small_dens = 1.0e4
castro.small_temp = 1.0e3

castro.do_sponge = 1
castro.sponge_upper_density = 1.0e5
castro.sponge_lower_density = 1.0e4
castro.sponge_timescale     = 1.0e-4

# NO damping, deliberately, after the damped run failed worse than the
# undamped one.
#
# With damping to 1.68 s the star drifted DOWN to rho_c = 0.66 while damped --
# away from the initial configuration, not onto it -- and then ran away the
# instant damping stopped, reaching 4e10 and aborting at t = 2.35 s. Damping
# removes kinetic energy, so an unbalanced star slides quasi-statically to
# wherever the residual force points; here it slid somewhere worse.
#
# Undamped at 64^3 on a laptop the same configuration lasted 2.2 s. This run
# is the apples-to-apples comparison at 96^3: does resolution extend that, in
# which case the collapse is a representation error, or not, in which case the
# configuration is dynamically unstable.
castro.add_ext_src = 0

problem.model_name = "phase1_scenario.txt"
problem.surface_density_frac = 1.0e-6
