#!/usr/bin/env bash
# Launches the Braithwaite desktop app (PyQt6) using the scf/.venv
# environment. Run from anywhere: ./braithwaite (if cwd is the repo
# root) or the full path to this script.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/scf/.venv/bin/python3" "$HERE/braithwaite_app/main.py" "$@"
